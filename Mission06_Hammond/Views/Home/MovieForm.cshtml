@model Movies

<!-- This is the form that is filled out and then the data is sent to the database -->

<h1>Enter Movies into the collection:</h1>

<form method="post">

	<input type="hidden" asp-for="MovieID" />

	<label asp-for="CategoryID">Category:</label>
	<select asp-for="CategoryID">
		<option value="">Select a Category</option>
		@foreach (Category m in ViewBag.Categories)
		{
			<option value="@m.CategoryID">@m.CategoryName</option>
		}
	</select>
	<br />
	<label asp-for="Title">Title:</label>
	<input asp-for="Title" />
	<br />
	<label asp-for="Year">Year:</label>
	<input asp-for="Year" />
	<br />
	<label asp-for="Director">Director:</label>
	<input asp-for="Director" />
	<br />
	<label asp-for="Rating">Rating:</label>
	<select asp-for="Rating" >
		<option value="G">G</option>
		<option value="PG">PG</option>
		<option value="PG-13">PG-13</option>
		<option value="R">R</option>
	</select>
	<br />
	<label asp-for="Edited">Edited:</label>
	<select asp-for="Edited">
		<option value="False">No</option>
		<option value="True">Yes</option>
	</select>
	<br />
	<label asp-for="LentTo">Lent to:</label>
	<input asp-for="LentTo" />
	<br />
	<label asp-for="CopiedToPlex">Copied to Plex:</label>
	<select asp-for="CopiedToPlex">
		<option value="False">No</option>
		<option value="True">Yes</option>
	</select>
	<br />
	<label asp-for="Notes">Notes:</label>
	<textarea asp-for="Notes" maxlength="25" placeholder="Enter notes (max 25 chars)" autocomplete="off" ></textarea>
	<br />

	<div asp-validation-summary="All"></div>

	<button type"submit">Submit Application</button>
</form>